font-family = JetBrainsMonoNL Nerd Font Mono
font-family = Symbols Nerd Font Mono
font-size = 10
font-style = SemiBold
font-style-italic = SemiBold Italic
font-style-bold = ExtraBold
font-style-bold-italic = ExtraBold Italic

adjust-cell-height = 10%

background-opacity = 1
window-padding-x = 0
window-padding-y = 0

gtk-titlebar = false
window-decoration = server

confirm-close-surface = false

cursor-style = block

theme = catppuccin-frappe.conf

clipboard-read = allow
clipboard-write = allow

shell-integration = none
shell-integration-features = no-cursor
working-directory = home

scrollback-limit = 10000000

copy-on-select = false

window-vsync = true

window-inherit-working-directory = true

# keybind = ctrl+shift+c=copy_to_clipboard
# keybind = ctrl+shift+v=paste_from_clipboard
# keybind = ctrl+v=paste_from_clipboard

keybind = alt+shift+l=new_window
keybind = alt+shift+j=decrease_font_size:3
keybind = alt+shift+k=increase_font_size:3
keybind = alt+shift+home=set_font_size:10
keybind = shift+insert=paste_from_clipboard

mouse-scroll-multiplier = 0.7
